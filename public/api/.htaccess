# Fountain Top Physiotherapy & Fitness Clinic - API Security Configuration
# Blocks direct HTTP access to data stores, logs, and sensitive PHP config files

Options -Indexes

# 1. Deny direct web access to sensitive files
<FilesMatch "(submissions\.(json|log)|\.log$|\.json$|email_config(\.example)?\.php|\.lock$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 2. Prevent HTTP methods other than GET, POST, OPTIONS
<LimitExcept GET POST OPTIONS>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</LimitExcept>
